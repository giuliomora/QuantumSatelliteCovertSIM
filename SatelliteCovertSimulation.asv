% =========================================================================
% SIMULAZIONE SATELLITARE QUANTUM COVERT (Micius-like)
% =========================================================================

clc; clear; close all;

% =========================================================================
% CINEMATICA ORBITALE E LINK BUDGET OTTICO
% =========================================================================
disp('--- FASE 1: Calcolo Link Budget Ottico ---');

% Costanti Fisiche
c = 3e8;                    % Velocità della luce (m/s)
lambda_0 = 267e-9;          % Lunghezza d'onda transizione Al+ (267 nm)
h_planck = 6.626e-34;       % Costante di Planck (J*s)
E_fotone = h_planck * (c / lambda_0); % Energia di un singolo fotone (J)

% Parametri Satellitari 
Altitudine = 800e3;         % Distanza di collegamento (800 km)
v_orbita = 7.6e3;           % Velocità orbitale (7.6 km/s)
D_tx = 0.20;                % Diametro telescopio Alice (200 mm)
D_rx = 0.30;                % Diametro telescopio Bob (300 mm)
P_tx_laser = 100e-3;        % Potenza laser di trasmissione (Ipotetica: 100 mW)

% Equazione di Friis (Link Budget)
% Guadagni delle Antenne Ottiche (Telescopi)
G_tx = (pi * D_tx / lambda_0)^2;
G_rx = (pi * D_rx / lambda_0)^2;

% Free Space Path Loss
FSPL = (4 * pi * Altitudine / lambda_0)^2;

% Potenza Ricevuta (senza contare l'atmosfera per semplicità)
P_rx = P_tx_laser * (G_tx * G_rx) / FSPL;

% Stampiamo i risultati in console
disp(['Distanza di link: ', num2str(Altitudine/1000), ' km']);
disp(['Potenza Laser in trasmissione: ', num2str(P_tx_laser*1000), ' mW']);
disp(['Potenza Ricevuta Teorica: ', num2str(P_rx), ' Watt']);

% =========================================================================
% FASE 2: GENERAZIONE DEL SEGNALE QUANTISTICO (ALICE)
% =========================================================================
disp('--- FASE 2: Generazione Segnale (Alluminio-27) ---');

% Vettori di Simulazione
Fs = 50e6;                  % Campionamento 50 MHz
T_coh = 1e-3;               % Tempo di coerenza 1 ms
N_campioni = Fs * T_coh;    % 50.000 campioni
omega = linspace(-1, 1, N_campioni); % Asse frequenze in banda base normalizzata

% Parametri Atomici
amu = 1.6605e-27;           % Unità di massa atomica (kg)
m_Al = 26.98 * amu;         % Massa Ione Alluminio

% Differenza di momento (delta p)
delta_v = 1;                % m/s
delta_p = m_Al * delta_v;   % Differenza di momento lineare

% 3. Il Messaggio Segreto e la Fisica
bit_tx = 0;                 % Il bit che Alice vuole inviare
if bit_tx == 0
    phi = 0;
else
    phi = pi;
end

% Chirp e l'Offset
c_chirp = 300 * pi;         % Tasso di dispersione (Chirp rate)
offset_quantistico = 100 * pi; % Spostamento dovuto alla differenza p2 - p1

% Fase totale del segnale quantistico
Phi_totale = c_chirp * (omega.^2) + offset_quantistico * omega;

% Creiamo l'interferenza con un inviluppo debolissimo (ordine v/c)
I_quant = 1e-5;             % Intensità bassissima
Interferenza_Alice = I_quant * cos(Phi_totale + phi);

disp('Generazione completata. Alice ha preparato il fotone covert.');

% =========================================================================
% FASE 3: IL CANALE COVERT E L'EFFETTO MACRO-DOPPLER (Eve)
% =========================================================================
disp('--- FASE 3: Simulazione Canale Spaziale (-41 dB) ---');

% 1. Il Macro-Doppler Orbitale (7.6 km/s del satellite)
Shift_Orbitale = 0.4; % Il segnale arriva shiftato del 40% dal centro

% 2. Generazione del Profilo Classico (Effetto Doppler termico)
sigma_doppler = 0.15; 
S_classico = exp(-((omega - Shift_Orbitale).^2) / (2 * sigma_doppler^2));

% Imponiamo il regime Covert a -41 dB
% FIX: L'atomo è sul
% satellite, il segnale quantistico deve subire lo stesso
% spostamento Doppler spaziale del rumore classico prima di viaggiare.
Phi_totale_shiftata = c_chirp * ((omega - Shift_Orbitale).^2) + offset_quantistico * (omega - Shift_Orbitale);
Interferenza_Alice_Shiftata = I_quant * cos(Phi_totale_shiftata + phi);

Potenza_Classica = mean(S_classico.^2);
Potenza_Target = Potenza_Classica * (10^(-41/10)); % SNR a -41 dB
Potenza_Attuale = mean(Interferenza_Alice_Shiftata.^2);

Fattore_di_Scala = sqrt(Potenza_Target / Potenza_Attuale);

% Il segnale quantistico viaggia insieme alla montagna termica spostata
Interferenza_Spaziale = Interferenza_Alice_Shiftata * Fattore_di_Scala;

% Aggiungiamo il Rumore di Fondo (Luce solare, AWGN)
Rumore_Spaziale = 0.02 * randn(1, N_campioni);

% IL SEGNALE RICEVUTO DA EVE E BOB
S_ricevuto = S_classico + Interferenza_Spaziale + Rumore_Spaziale;

% =========================================================================
% FASE 4: IL RICEVITORE DI BOB (Tracking, Clutter Rejection, FrFT)
% =========================================================================
disp('--- FASE 4: Decodifica Ricevitore di Bob ---');

% 1. TRACKING SATELLITARE (Compensazione Macro-Doppler)
% Bob sa che il satellite viaggia a 7.6 km/s. Riporta il segnale al centro.
% (Nella realtà lo fa un Phase-Locked Loop - PLL)
% FIX: Usiamo l'interpolazione per traslare il segnale senza "arrotolarlo" 
% ai bordi, evitando artefatti di fase (Wrap-around Error).
S_centrato = interp1(omega, S_ricevuto, omega + Shift_Orbitale, 'linear', 0);

% 2. CLUTTER REJECTION (Rimozione del Bias Termico)
% Bob applica il filtro passa-alto per salvare la Gamma Dinamica (Baseline Subtraction)
S_filtrato = S_centrato - movmean(S_centrato, 500);

% 3. LA CHIAVE FrFT (De-Chirping)
% Bob compensa SOLO la curvatura spaziale (c_chirp) dell'Alluminio
Chiave_FrFT = exp(-1i * (c_chirp * (omega.^2)));

% 4. ESTRAZIONE DEL PICCO (FFT)
Segnale_Ruotato = S_filtrato .* Chiave_FrFT;
Y_Bob = fftshift(fft(Segnale_Ruotato));
Picco_Bob = real(Y_Bob);


% =========================================================================
% FASE 5: VISUALIZZAZIONE DEL REPORT E GRAFICI
% =========================================================================
disp('--- FASE 5: Generazione Grafici ---');

figure('Name', 'Link Satellitare Quantum Covert', 'Color', 'w', 'Position', [100, 100, 900, 600]);

% Grafico 1: Quello che si vede nel canale spaziale (Eve)
subplot(2, 1, 1);
plot(omega, S_ricevuto, 'Color', [0.6 0.6 0.6]);
title('1. Canale Intercettato (SNR = -41 dB, Shift Doppler 7.6 km/s)');
xlabel('\omega (Banda Base)'); ylabel('Ampiezza'); grid on;

% Grafico 2: Quello che estrae il telescopio di Bob
u = linspace(-1, 1, N_campioni);
subplot(2, 1, 2);
plot(u, Picco_Bob, 'b', 'LineWidth', 1.5);
title(['2. Decodifica FrFT (Bit Trasmesso: ', num2str(bit_tx), ')']);
xlabel('u (Dominio Frazionario)'); ylabel('Ampiezza del Picco'); grid on;
xlim([-0.2 0.2]); % Zoom per apprezzare la pulizia del picco

disp('SIMULAZIONE COMPLETATA CON SUCCESSO!');